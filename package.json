{
  "name": "tuvi-iztro-custom-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-pages.mjs && node scripts/buildKnowledgeShards.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:standalone": "npm run build && node make-standalone.mjs",
    "standalone": "node make-standalone.mjs",
    "preview": "vite preview",
    "verify:tuvi": "tsc -p tsconfig.verify.json && node .tmp-verify/scripts/verifyTuvi.js",
    "verify:tuvi:rules": "tsc -p tsconfig.verify.json && node .tmp-verify/scripts/verifyGeneralRules.js",
    "check:tuvi-snapshot": "npm run verify:tuvi",
    "check:luu-stars": "tsc -p tsconfig.verify.json && node .tmp-verify/scripts/checkLuuStars.js",
    "check:mutagens": "tsc -p tsconfig.verify.json && node .tmp-verify/scripts/checkMutagens.js",
    "compare:tuvichanco": "tsc -p tsconfig.verify.json && node .tmp-verify/scripts/compare-with-tuvichanco.js --reference-file=tests/fixtures/tuvichanco/2026-06-10-1330.json --local-file=tests/fixtures/local/2026-06-10-1330.json --assert-thresholds=true",
    "compare:tuvichanco:natal": "tsc -p tsconfig.verify.json && node .tmp-verify/scripts/compare-with-tuvichanco.js --reference-file=tests/fixtures/tuvichanco/2026-06-10-1330.json --local-file=tests/fixtures/local/2026-06-10-1330.json --mode=natal",
    "verify:knowledge": "esbuild scripts/verifyKnowledgeMatching.ts --bundle --platform=node --log-level=warning --outfile=.tmp-verify/verifyKnowledgeMatching.js && node --max-old-space-size=4096 .tmp-verify/verifyKnowledgeMatching.js",
    "knowledge:normalize": "esbuild scripts/normalizeKnowledge.ts --bundle --platform=node --log-level=warning --outfile=.tmp-verify/normalizeKnowledge.js && node --max-old-space-size=4096 .tmp-verify/normalizeKnowledge.js",
    "sample:knowledge": "esbuild scripts/sampleKnowledge.ts --bundle --platform=node --log-level=warning --outfile=.tmp-verify/sampleKnowledge.js && node --max-old-space-size=4096 .tmp-verify/sampleKnowledge.js",
    "quality:knowledge": "esbuild scripts/knowledgeQuality.ts --bundle --platform=node --log-level=warning --outfile=.tmp-verify/knowledgeQuality.js && node --max-old-space-size=4096 .tmp-verify/knowledgeQuality.js",
    "crawl": "esbuild scripts/kb/crawl.ts --bundle --platform=node --packages=external --log-level=warning --outfile=.tmp-verify/kb-crawl.js && node .tmp-verify/kb-crawl.js",
    "kb:extract": "esbuild scripts/kb/extract.ts --bundle --platform=node --packages=external --log-level=warning --outfile=.tmp-verify/kb-extract.js && node .tmp-verify/kb-extract.js",
    "kb:map": "esbuild scripts/kb/map.ts --bundle --platform=node --packages=external --log-level=warning --outfile=.tmp-verify/kb-map.js && node --max-old-space-size=4096 .tmp-verify/kb-map.js",
    "kb:apply": "esbuild scripts/kb/apply.ts --bundle --platform=node --packages=external --log-level=warning --outfile=.tmp-verify/kb-apply.js && node .tmp-verify/kb-apply.js",
    "validate-knowledge": "esbuild scripts/kb/validate.ts --bundle --platform=node --packages=external --log-level=warning --outfile=.tmp-verify/kb-validate.js && node .tmp-verify/kb-validate.js",
    "test-knowledge-server": "esbuild scripts/kb/serverParity.ts --bundle --platform=node --log-level=warning --outfile=.tmp-verify/kb-server-parity.js && node --max-old-space-size=4096 .tmp-verify/kb-server-parity.js",
    "test-kb": "esbuild scripts/kb/kb.test.ts --bundle --platform=node --packages=external --log-level=warning --outfile=.tmp-verify/kb.test.js && node --test .tmp-verify/kb.test.js"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "cheerio": "^1.2.0",
    "html-to-image": "^1.11.13",
    "iztro": "^1.0.0",
    "leaflet": "^1.9.4",
    "node-fetch": "^2.7.0",
    "playwright": "^1.63.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.0.0",
    "esbuild": "^0.25.12",
    "puppeteer": "^25.11.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}
