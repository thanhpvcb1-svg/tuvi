# Gemini API - Cấu hình trên Cloudflare Dashboard
# Settings > Environment Variables:
# - GEMINI_API_KEY = your_api_key
# - GEMINI_MODEL = gemini-2.5-flash (hoặc gemini-1.5-flash)

# Contact - để trống cho tới khi có kênh thật (trang chỉ hiện kênh đã cấu hình).
# Có thể đặt trên Cloudflare Pages > Settings > Environment Variables thay cho file này.
# Ví dụ: VITE_CONTACT_ZALO_URL=https://zalo.me/<số điện thoại hoặc OA>
VITE_CONTACT_EMAIL=
VITE_CONTACT_ZALO_URL=
VITE_CONTACT_FACEBOOK_URL=
