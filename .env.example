# ============================================
# LaSoTuVi - Environment Variables
# ============================================
# Copy file này thành .env và điền thông tin thực

# ============================================
# CONTACT INFORMATION (Frontend)
# ============================================
# Thông tin liên hệ hiển thị trên website
VITE_CONTACT_EMAIL=contact@lasotuvi.com
VITE_CONTACT_SMS_NUMBER=0901234567
VITE_CONTACT_ZALO_URL=https://zalo.me/0901234567
VITE_CONTACT_FACEBOOK_URL=https://fb.com/lasotuvi

# ============================================
# GOOGLE ANALYTICS (Frontend)
# ============================================
# Thay GA_MEASUREMENT_ID trong index.html bằng ID thực
# Ví dụ: G-XXXXXXXXXX

# ============================================
# AI SERVICE (Server-side only)
# ============================================
# Cấu hình trên Cloudflare Pages Dashboard > Settings > Environment Variables
# KHÔNG đưa vào file .env frontend
# GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# YOUTUBE LESSONS (Server-side only)
# ============================================
# YOUTUBE_LESSONS_CHANNEL_ID=your_youtube_channel_id

# ============================================
# NOTES
# ============================================
# 1. Các biến VITE_* sẽ được expose ra frontend
# 2. Các biến không có prefix VITE_ chỉ dùng server-side
# 3. KHÔNG commit file .env vào git
# 4. Cấu hình production trên Cloudflare Pages Dashboard
